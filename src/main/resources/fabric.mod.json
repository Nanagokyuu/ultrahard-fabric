{
	"schemaVersion": 1,
	"id": "ultrahard",
	"version": "${version}",
	"name": "Ultra Hard",
	"description": "Adds Ultra Hard difficulty (based on Hard): no natural regen, faster hunger, one-hit kills.",
	"authors": [
		"Nanagokyuu"
	],
	"contact": {
		"sources": "https://github.com/Nanagokyuu/ultrahard-fabric"
	},
	"license": "MIT",
	"icon": "assets/ultrahard/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"adapter": "kotlin",
				"value": "com.nanagokyuu.ultrahard.UltraHardMod"
			}
		]
	},
	"mixins": [
		"ultrahard.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": ">=1.13.12+kotlin.2.4.0"
	},
	"accessWidener": "ultrahard.classtweaker"
}
